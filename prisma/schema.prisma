// Mansello backend — Prisma schema
// NOTE: the Postgres exclusion constraints that guarantee no two active
// bookings/blocks can overlap for the same property CANNOT be expressed
// here. They're added by raw-SQL migrations — see
// prisma/migrations_manual/001_exclusion_constraint.sql (the original,
// pre-rooms single constraint), prisma/migrations/20260815000000_sri_lanka_rooms
// (temporarily split it into two, room-scoped constraints — since
// superseded), and prisma/migrations/20260901000000_pricing_discounts_shipping
// (current: whole-villa locking, split by bookingId instead of roomId — see
// that migration's comments for why) and SUPABASE_SETUP.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StripeAccountRef {
  italy
  sri_lanka
}

enum AvailabilitySource {
  direct
  airbnb
  manual
}

enum BlockStatus {
  active
  cancelled
}

enum BookingStatus {
  pending_payment
  confirmed
  paid_offline
  cancelled
  completed
}

enum TransportType {
  fixed_price
  custom_quote
}

enum LeadStatus {
  new
  read
  responded
}

enum BookingInfoRequestStatus {
  pending
  submitted
  expired
}

enum OrderStatus {
  pending
  confirmed
  packed
  shipped
  delivered
  cancelled
  returned
}

enum ContactSubject {
  room_booking
  airport_transfer
  marketplace
  other
}

enum Site {
  italy
  sri_lanka
}

enum AdminRole {
  super_admin
  villa_manager
  marketplace_manager
}

enum ClickDevice {
  desktop
  tablet
  mobile
}

model Property {
  id                    String           @id @default(uuid())
  slug                  String           @unique // "the-nest-bologna" | "donas-villa"
  name                  String
  country               String
  currency              String           @default("usd")
  timezone              String // IANA, e.g. Europe/Rome / Asia/Colombo
  checkInTime           String // "15:00"
  checkOutTime          String // "11:00"
  minNights             Int              @default(1)
  turnoverBufferDays    Int              @default(0)
  maxGuests             Int
  address               String
  stripeAccountRef      StripeAccountRef
  airbnbIcalImportUrls  String[]         @default([]) // Airbnb "Export Calendar" URLs we poll — a property
  // can be double/triple-listed on Airbnb (e.g. whole villa + individual rooms sold
  // separately), each with its own feed; all of them feed into this one property's
  // shared AvailabilityBlock pool. Booking.com feeds go in here too once obtained.
  icalExportToken       String           @unique @default(uuid()) // used to build our own export feed URL
  // Bologna municipal tourist tax (imposta di soggiorno) — a per-property
  // on/off switch, not hardcoded to one slug. Dona's Villa (Sri Lanka) has
  // no equivalent and leaves these at their defaults. See computeBookingPrice
  // in modules/bookings/service.ts for how cityTaxBands is interpreted.
  cityTaxEnabled        Boolean          @default(false)
  cityTaxMaxNights      Int              @default(5) // nights beyond this aren't taxed — the room price still is
  cityTaxExemptAgeUnder Int              @default(14) // guests younger than this pay no tax
  cityTaxBands          Json             @default("[]") // CityTaxBand[] — { minPricePerPersonPerNight, maxPricePerPersonPerNight: number | null, ratePerPersonPerNight }[], sorted ascending
  // Priced airport-transfer add-on — a property-wide kill switch, separate
  // from each TransportRate row's own `active` flag (that's "no vehicle for
  // this party size"; this is "we don't offer this at all"). false is the
  // default so an unmigrated property behaves exactly as before this
  // feature existed. See BACKEND_CHANGES_VILLA_TRANSPORT.md.
  transportEnabled      Boolean          @default(false)
  // Whether the Airbnb import keeps today's padded checkout-day behavior
  // (true, the default) or trims the imported block's end date back by one
  // day (false) — see BACKEND_CHANGES_ICAL_MINUS_ONE_DAY.md. Named for what
  // `true` means so an unmigrated/unconfigured property is unchanged: this
  // was investigated and found NOT to apply to either real property as
  // deployed (no evidence of feed padding, turnoverBufferDays already 0) —
  // this column exists so a specific listing can be opted in later, only
  // after confirming its own feed actually pads, never flip this without
  // that confirmation first.
  icalCheckoutDayBuffer Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  pricingTiers       PricingTier[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  transportRequests  TransportRequest[]
  transportRates     TransportRate[]
  adminUsers         AdminUser[]
  offers             Offer[]
  rooms              Room[]
  rateOverrides      RateOverride[]
}

// Priced-per-party airport transfer, one row per guest count 1–8 — a
// separate concept from TransportRequest above (that's the unpriced
// enquiry/quote lead that still fires alongside this; this is what makes
// the transfer an add-on the guest pays for at checkout). See
// BACKEND_CHANGES_VILLA_TRANSPORT.md.
model TransportRate {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestCount Int // 1–8, exact match only — no banding (see modules/bookings/service.ts)
  price      Decimal  @default(0) @db.Decimal(10, 2) // flat price for the whole party, not per person
  active     Boolean  @default(false) // lets a property stop offering a given party size without losing the configured price
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, guestCount])
}

// Individually-bookable rooms (Dona's Villa) — a property with zero Room
// rows keeps booking as a single unit via PricingTier exactly as before
// (The Nest Bologna); every change this model brought with it is additive
// and no-ops for that case. See BACKEND_CHANGES_SRI_LANKA_ROOMS.md.
model Room {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  subtitle      String?
  capacity      Int // max guests this room sleeps
  pricePerNight Decimal  @db.Decimal(10, 2)
  images        String[] @default([])
  sortOrder     Int      @default(0)
  active        Boolean  @default(true) // false retires a room without breaking historical bookings/blocks that reference it
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  availabilityBlocks AvailabilityBlock[]
  rateOverrides      RateOverride[]

  @@index([propertyId, active])
}

// Seasonal/date-range price overrides — exactly one of `roomId` or
// `(guestCount, rooms)` is set per row, matching whichever pricing model
// the property uses (roomId for a room-based property, guestCount+rooms
// referencing a PricingTier for a tier-based one). Resolved per night in
// computeBookingPrice — a night whose date falls in [startDate, endDate]
// uses this pricePerNight instead of the base rate; nights outside any
// override use the base rate as before. See
// BACKEND_CHANGES_PRICING_DISCOUNTS_SHIPPING.md §1.
model RateOverride {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestCount    Int?
  rooms         Int?
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date // inclusive
  pricePerNight Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, startDate, endDate])
  @@index([roomId])
}

model PricingTier {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestCount    Int
  rooms         Int      @default(1) // how many rooms this tier's price covers — always 1 for
  // single-unit properties (e.g. The Nest Bologna); Dona's Villa offers the same party
  // size at more than one room count (e.g. 2 guests in 1 room vs. 2 guests in 2 rooms)
  // at different prices, so guestCount alone isn't a unique key.
  pricePerNight Decimal  @db.Decimal(10, 2)

  @@unique([propertyId, guestCount, rooms])
}

// Unified date-range table. Every active booking (direct or Airbnb-imported)
// has exactly one row here. The exclusion constraints live on this table.
//
// Whole-villa locking (BACKEND_CHANGES_PRICING_DISCOUNTS_SHIPPING.md §3,
// supersedes the independent-per-room-availability design
// BACKEND_CHANGES_SRI_LANKA_ROOMS.md originally shipped): only one party
// occupies a room-enabled property at a time, so a block on ANY room now
// makes the WHOLE property unavailable, not just that one room — the
// opposite of what roomId used to mean for availability purposes. roomId
// is still recorded per block (still useful for admin display — which room
// a block/booking is actually for) and a room-booking still creates one
// block per reserved room, but availability is computed by ignoring roomId
// entirely and asking "does ANY active block for this property overlap?" —
// exactly the original, pre-rooms rule. The one new wrinkle: a single
// booking's own several per-room blocks (same bookingId) must NOT conflict
// with EACH OTHER even though they share the same date range — see the two
// exclusion constraints in SUPABASE_SETUP.md for how that's expressed.
model AvailabilityBlock {
  id          String             @id @default(uuid())
  propertyId  String
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId      String? // which room this block is actually for — display/admin only now, not consulted for availability (see model comment)
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  source      AvailabilitySource
  status      BlockStatus        @default(active)
  externalUid String? // Airbnb UID, used to dedupe on re-sync
  bookingId   String? // no longer unique — a room booking creates one block per reserved room, all sharing one bookingId
  booking     Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([propertyId, status])
  @@index([externalUid])
  @@index([roomId, status])
  @@index([bookingId])
}

model Booking {
  id                    String        @id @default(uuid())
  propertyId            String
  property              Property      @relation(fields: [propertyId], references: [id])
  guestName             String
  guestEmail            String
  guestPhone            String
  guestIdDocumentType   String?
  guestIdDocumentNumber String?
  checkIn               DateTime      @db.Date
  checkOut              DateTime      @db.Date
  guests                Int
  rooms                 Int           @default(1) // room *count* — which PricingTier (guestCount, rooms) priced this stay for a non-room property; for a room-booking this is just roomIds.length, derived server-side
  roomIds               String[]      @default([]) // specific Room ids reserved — non-empty iff the property has rooms configured, empty for single-unit properties (The Nest Bologna)
  accommodationPrice    Decimal       @db.Decimal(10, 2) // pure room cost: pricePerNight × nights — what totalPrice meant before city tax existed
  cityTax               Decimal       @default(0) @db.Decimal(10, 2) // computed from Property.cityTaxBands; 0 when the property doesn't have cityTaxEnabled
  transportPrice        Decimal       @default(0) @db.Decimal(10, 2) // flat, charged once regardless of nights — 0 unless transportRequested was true AND a matching active TransportRate existed at booking time. See BACKEND_CHANGES_VILLA_TRANSPORT.md
  childrenUnder14       Int           @default(0) // recorded for audit — the exemption math is already baked into cityTax by the time this is stored
  totalPrice            Decimal       @db.Decimal(10, 2) // = accommodationPrice + cityTax + transportPrice — the amount actually charged via Stripe
  currency              String        @default("usd")
  stripePaymentIntentId String?
  status                BookingStatus @default(pending_payment)
  expiresAt             DateTime? // pending_payment hold expiry
  cancelledAt           DateTime?
  refundAmount          Decimal?      @db.Decimal(10, 2)
  refundReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Plural now — a room-booking creates one AvailabilityBlock per reserved
  // room instead of the single whole-property block a non-room booking
  // still creates (bookingId is no longer unique on that table).
  availabilityBlocks AvailabilityBlock[]
  transportRequests  TransportRequest[]
  infoRequests       BookingInfoRequest[]

  @@index([propertyId, status])
}

model TransportRequest {
  id           String        @id @default(uuid())
  propertyId   String?
  property     Property?     @relation(fields: [propertyId], references: [id])
  bookingId    String? // set when submitted as a booking add-on; null for standalone Transport page requests
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  type         TransportType
  date         DateTime
  flightNumber String?
  passengers   Int           @default(1)
  contactName  String
  contactEmail String
  contactPhone String
  notes        String?
  status       LeadStatus    @default(new)
  createdAt    DateTime      @default(now())
}

// Single shared row (id is always the fixed string "default") — the admin-
// authored question list guests are asked to fill in per booking. See
// BookingInfoRequest below, which snapshots this at send time so editing the
// template later never changes a link that's already gone out.
model GuestInfoFormTemplate {
  id        String   @id @default("default")
  fields    Json     @default("[]") // GuestInfoField[] — shape documented in modules/guestInfo/service.ts
  updatedAt DateTime @updatedAt
}

model BookingInfoRequest {
  id          String                   @id @default(uuid())
  bookingId   String
  booking     Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  token       String                   @unique @default(uuid()) // same trust model as Property.icalExportToken — knowing it is the access control
  status      BookingInfoRequestStatus @default(pending)
  fields      Json // GuestInfoField[] snapshot of GuestInfoFormTemplate.fields at creation time
  answers     Json? // { [fieldId]: string | boolean }, set on submit
  expiresAt   DateTime // createdAt + 14 days
  submittedAt DateTime?
  createdAt   DateTime                 @default(now())

  @@index([bookingId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String? // short blurb for the storefront's featured section
  imageUrl    String?
  featured    Boolean   @default(false) // at most 4 across all categories, enforced in modules/marketplace/catalog/service.ts
  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String
  priceUsd    Decimal  @db.Decimal(10, 2)
  images      String[]
  sku         String   @unique
  active      Boolean  @default(true)
  weightKg    Decimal? @db.Decimal(10, 3) // kg per single unit; null/absent (e.g. a pre-existing product) treated as 0kg for shipping purposes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockLevel StockLevel?
  orderItems OrderItem[]
}

// Small, admin-managed global table (not per-product) — a price-per-kg band
// table used to compute an order's shippingFee from its total weight. See
// BACKEND_CHANGES_PRICING_DISCOUNTS_SHIPPING.md §4.
// Bands are exactly 1kg wide in practice (fromKg == toKg on every row the
// admin UI creates) and `price` is the FLAT delivery charge for an order in
// that band — NOT a per-kg rate multiplied by weight. Renamed from
// `pricePerKg` (BACKEND_CHANGES_SHIPPING_FLAT_BAND_PRICING.md) after that
// name caused a real production bug: the client filled in "$9.99 for a 3kg
// order" and it got charged as 3 × $9.99 = $29.97. Existing values were NOT
// transformed by that migration — they were always flat prices, just
// multiplied incorrectly by application code.
model ShippingRate {
  id        String   @id @default(uuid())
  fromKg    Int
  toKg      Int
  price     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockLevel {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand    Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt
}

model Order {
  id                    String      @id @default(uuid())
  customerName          String
  customerPhone         String
  deliveryAddress       String
  notes                 String?
  status                OrderStatus @default(pending)
  // "cod" survives as a historical value on pre-BACKEND_CHANGES_MARKETPLACE_PAYMENTS
  // rows only — every order created after that change is "card": checkout now
  // requires a successful Stripe PaymentIntent the same way a villa booking
  // does, see stripePaymentIntentId below.
  paymentMethod         String      @default("card")
  stripePaymentIntentId String? // set once the order's PaymentIntent is created (before payment succeeds — mirrors Booking.stripePaymentIntentId, attached pre-payment so the webhook has something to match against)
  shippingFee           Decimal     @db.Decimal(10, 2)
  subtotal              Decimal     @db.Decimal(10, 2)
  total                 Decimal     @db.Decimal(10, 2)
  flaggedForReview      Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items OrderItem[]

  @@index([customerPhone])
  @@index([status])
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @db.Decimal(10, 2)
}

model ContactMessage {
  id        String         @id @default(uuid())
  site      Site
  name      String
  email     String
  subject   ContactSubject
  message   String
  status    LeadStatus     @default(new)
  createdAt DateTime       @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String
  site         Site
  subscribedAt DateTime @default(now())

  @@unique([email, site])
}

// At most one active offer per property is enforced at the application
// layer (see modules/offers/service.ts) rather than a DB constraint — same
// class of soft business rule as turnoverBufferDays, low-stakes enough not
// to need one.
model Offer {
  id              String    @id @default(uuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title           String
  discountPercent Int
  imageUrl        String?
  active          Boolean   @default(false)
  // Both nullable — null/absent on either means "no date limit," so an
  // offer created before this field existed keeps applying whenever
  // active: true, unchanged. When set, only nights whose date falls in
  // [startDate, endDate] get discountPercent off at checkout; other
  // nights of the same stay price normally. See
  // BACKEND_CHANGES_PRICING_DISCOUNTS_SHIPPING.md §2.
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([propertyId])
}

model BlogPost {
  id            String    @id @default(uuid())
  site          Site
  slug          String    @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  author        String
  publishedAt   DateTime? // null = draft, not publicly visible
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([site, publishedAt])
}

model AdminUser {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            AdminRole
  propertyScopeId String?
  propertyScope   Property? @relation(fields: [propertyScopeId], references: [id])
  // Embedded in every issued JWT (access + refresh); bumped by POST
  // /api/admin/logout. A refresh token whose embedded value no longer
  // matches this is rejected — this is the only real server-side session
  // revocation this app has, since tokens are otherwise pure stateless
  // JWTs with no other server-side record. Deliberately checked only in
  // refresh(), not in requireAuth on every request: an already-issued
  // access token stays valid for its own short natural lifetime
  // (JWT_ACCESS_EXPIRES_IN, 15min default) after logout rather than this
  // adding a DB round-trip to every single authenticated request. See
  // BACKEND_CHANGES_SEO_SECURITY_HARDENING.md §6.6.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  siteContentEdits SiteContent[]
}

// Raw, high-volume click-heatmap data — not tied to Property/Booking/etc.,
// just a page path and a normalized click position. No relations
// deliberately: this table needs to stay cheap to insert into (public,
// unauthenticated, up to 50 rows per beacon) and is only ever read back in
// aggregate (modules/analytics/service.ts), never joined against anything
// else. `BigInt` autoincrement id rather than this schema's usual
// `String @default(uuid())` — a real, deliberate departure for exactly
// this one high-volume table, not a stray inconsistency; see
// BACKEND_CHANGES_HEATMAP_ANALYTICS.md. No visitor-identifying data
// (`sessionId` is a random per-tab id, not an account or fingerprint) — see
// that doc before adding any (IP, user agent, etc.).
model ClickEvent {
  id             BigInt      @id @default(autoincrement())
  site           Site? // null for pages not under /italy or /sri-lanka (e.g. a shared homepage)
  path           String // e.g. "/sri-lanka/airbnb"
  xPct           Float       @db.Real // 0–1, fraction of page width at click time — resolution-independent, never raw pixels
  yPct           Float       @db.Real // 0–1, fraction of page height, against scrollHeight
  viewportWidth  Int
  device         ClickDevice // coarse bucket computed client-side from window.innerWidth, matches the admin preview iframe's virtual widths
  sessionId      String // random UUID in sessionStorage — resets every tab/session, exists only to count distinct "page views" apart from raw click volume
  targetSelector String? // best-effort "tag#id.class" — informational only
  occurredAt     DateTime // client-reported click time
  createdAt      DateTime    @default(now()) // server receive time

  @@index([path, device, occurredAt])
}

// Admin-manageable reviews for the "Our Client Says!" carousels — scoped to
// a Site as a whole (Italy vs Sri Lanka), not an individual Property, since
// that's how the carousel is used today. See
// BACKEND_CHANGES_TESTIMONIALS.md.
model Testimonial {
  id        String   @id @default(uuid())
  site      Site
  name      String
  role      String // freeform, e.g. "Airbnb Guest · 1 night" — matches today's hardcoded copy
  quote     String
  rating    Int // 1–5
  sortOrder Int      @default(0)
  active    Boolean  @default(true) // false = unpublished (e.g. a guest asks for it to come down) without losing the record
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([site, active, sortOrder])
}

// Flat key/value store for admin-editable marketing copy — deliberately not
// a schema-per-section design. The frontend owns the schema (which keys
// exist, their type, default, and which component renders them —
// src/lib/content/schema.ts); this table only stores strings against
// opaque keys like "italy.hero.title" or "global.contact.email". Adding a
// new editable field on the frontend never requires a backend change: an
// absent key just means "use the built-in default" — see
// BACKEND_CHANGES_SITE_CONTENT.md. `key` is never parsed or validated
// against a known list; only its `value` gets format-checked (size cap,
// URL-shape check for image/social keys — modules/content/validation.ts).
model SiteContent {
  key         String     @id
  value       String
  updatedAt   DateTime   @updatedAt
  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}
