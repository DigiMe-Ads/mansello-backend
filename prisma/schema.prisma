// Mansello backend — Prisma schema
// NOTE: the Postgres exclusion constraints that guarantee no two active
// bookings/blocks can overlap for the same property (or the same room)
// CANNOT be expressed here. They're added by raw-SQL migrations — see
// prisma/migrations_manual/001_exclusion_constraint.sql (the original,
// pre-rooms single constraint) and prisma/migrations/20260815000000_sri_lanka_rooms
// (splits it into two, one whole-property-only and one same-room-only —
// see that migration's comments for why) and SUPABASE_SETUP.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StripeAccountRef {
  italy
  sri_lanka
}

enum AvailabilitySource {
  direct
  airbnb
  manual
}

enum BlockStatus {
  active
  cancelled
}

enum BookingStatus {
  pending_payment
  confirmed
  paid_offline
  cancelled
  completed
}

enum TransportType {
  fixed_price
  custom_quote
}

enum LeadStatus {
  new
  read
  responded
}

enum BookingInfoRequestStatus {
  pending
  submitted
  expired
}

enum OrderStatus {
  pending
  confirmed
  packed
  shipped
  delivered
  cancelled
  returned
}

enum ContactSubject {
  room_booking
  airport_transfer
  marketplace
  other
}

enum Site {
  italy
  sri_lanka
}

enum AdminRole {
  super_admin
  villa_manager
  marketplace_manager
}

model Property {
  id                    String           @id @default(uuid())
  slug                  String           @unique // "the-nest-bologna" | "donas-villa"
  name                  String
  country               String
  currency              String           @default("usd")
  timezone              String // IANA, e.g. Europe/Rome / Asia/Colombo
  checkInTime           String // "15:00"
  checkOutTime          String // "11:00"
  minNights             Int              @default(1)
  turnoverBufferDays    Int              @default(0)
  maxGuests             Int
  address               String
  stripeAccountRef      StripeAccountRef
  airbnbIcalImportUrls  String[]         @default([]) // Airbnb "Export Calendar" URLs we poll — a property
  // can be double/triple-listed on Airbnb (e.g. whole villa + individual rooms sold
  // separately), each with its own feed; all of them feed into this one property's
  // shared AvailabilityBlock pool. Booking.com feeds go in here too once obtained.
  icalExportToken       String           @unique @default(uuid()) // used to build our own export feed URL
  // Bologna municipal tourist tax (imposta di soggiorno) — a per-property
  // on/off switch, not hardcoded to one slug. Dona's Villa (Sri Lanka) has
  // no equivalent and leaves these at their defaults. See computeBookingPrice
  // in modules/bookings/service.ts for how cityTaxBands is interpreted.
  cityTaxEnabled        Boolean          @default(false)
  cityTaxMaxNights      Int              @default(5) // nights beyond this aren't taxed — the room price still is
  cityTaxExemptAgeUnder Int              @default(14) // guests younger than this pay no tax
  cityTaxBands          Json             @default("[]") // CityTaxBand[] — { minPricePerPersonPerNight, maxPricePerPersonPerNight: number | null, ratePerPersonPerNight }[], sorted ascending
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  pricingTiers       PricingTier[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  transportRequests  TransportRequest[]
  adminUsers         AdminUser[]
  offers             Offer[]
  rooms              Room[]
}

// Individually-bookable rooms (Dona's Villa) — a property with zero Room
// rows keeps booking as a single unit via PricingTier exactly as before
// (The Nest Bologna); every change this model brought with it is additive
// and no-ops for that case. See BACKEND_CHANGES_SRI_LANKA_ROOMS.md.
model Room {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  subtitle      String?
  capacity      Int // max guests this room sleeps
  pricePerNight Decimal  @db.Decimal(10, 2)
  images        String[] @default([])
  sortOrder     Int      @default(0)
  active        Boolean  @default(true) // false retires a room without breaking historical bookings/blocks that reference it
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  availabilityBlocks AvailabilityBlock[]

  @@index([propertyId, active])
}

model PricingTier {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestCount    Int
  rooms         Int      @default(1) // how many rooms this tier's price covers — always 1 for
  // single-unit properties (e.g. The Nest Bologna); Dona's Villa offers the same party
  // size at more than one room count (e.g. 2 guests in 1 room vs. 2 guests in 2 rooms)
  // at different prices, so guestCount alone isn't a unique key.
  pricePerNight Decimal  @db.Decimal(10, 2)

  @@unique([propertyId, guestCount, rooms])
}

// Unified date-range table. Every active booking (direct or Airbnb-imported)
// has exactly one row here. The exclusion constraint lives on this table.
model AvailabilityBlock {
  id          String             @id @default(uuid())
  propertyId  String
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // null = blocks every room on the property (whole-property block — what
  // every block was before rooms existed: manual blocks, Airbnb imports,
  // and any property with zero rooms all keep using this unchanged). Set =
  // blocks just that one room. See modules/bookings/service.ts and
  // modules/availability/service.ts for how overlap is actually enforced
  // across the null/specific split — it's split across two exclusion
  // constraints (SUPABASE_SETUP.md) plus one application-level check,
  // not a single constraint, because Postgres has no operator for
  // "NULL matches every value" inside an EXCLUDE.
  roomId      String?
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  source      AvailabilitySource
  status      BlockStatus        @default(active)
  externalUid String? // Airbnb UID, used to dedupe on re-sync
  bookingId   String? // no longer unique — a room booking creates one block per reserved room, all sharing one bookingId
  booking     Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([propertyId, status])
  @@index([externalUid])
  @@index([roomId, status])
  @@index([bookingId])
}

model Booking {
  id                    String        @id @default(uuid())
  propertyId            String
  property              Property      @relation(fields: [propertyId], references: [id])
  guestName             String
  guestEmail            String
  guestPhone            String
  guestIdDocumentType   String?
  guestIdDocumentNumber String?
  checkIn               DateTime      @db.Date
  checkOut              DateTime      @db.Date
  guests                Int
  rooms                 Int           @default(1) // room *count* — which PricingTier (guestCount, rooms) priced this stay for a non-room property; for a room-booking this is just roomIds.length, derived server-side
  roomIds               String[]      @default([]) // specific Room ids reserved — non-empty iff the property has rooms configured, empty for single-unit properties (The Nest Bologna)
  accommodationPrice    Decimal       @db.Decimal(10, 2) // pure room cost: pricePerNight × nights — what totalPrice meant before city tax existed
  cityTax               Decimal       @default(0) @db.Decimal(10, 2) // computed from Property.cityTaxBands; 0 when the property doesn't have cityTaxEnabled
  childrenUnder14       Int           @default(0) // recorded for audit — the exemption math is already baked into cityTax by the time this is stored
  totalPrice            Decimal       @db.Decimal(10, 2) // = accommodationPrice + cityTax — the amount actually charged via Stripe
  currency              String        @default("usd")
  stripePaymentIntentId String?
  status                BookingStatus @default(pending_payment)
  expiresAt             DateTime? // pending_payment hold expiry
  cancelledAt           DateTime?
  refundAmount          Decimal?      @db.Decimal(10, 2)
  refundReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Plural now — a room-booking creates one AvailabilityBlock per reserved
  // room instead of the single whole-property block a non-room booking
  // still creates (bookingId is no longer unique on that table).
  availabilityBlocks AvailabilityBlock[]
  transportRequests  TransportRequest[]
  infoRequests       BookingInfoRequest[]

  @@index([propertyId, status])
}

model TransportRequest {
  id           String        @id @default(uuid())
  propertyId   String?
  property     Property?     @relation(fields: [propertyId], references: [id])
  bookingId    String? // set when submitted as a booking add-on; null for standalone Transport page requests
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  type         TransportType
  date         DateTime
  flightNumber String?
  passengers   Int           @default(1)
  contactName  String
  contactEmail String
  contactPhone String
  notes        String?
  status       LeadStatus    @default(new)
  createdAt    DateTime      @default(now())
}

// Single shared row (id is always the fixed string "default") — the admin-
// authored question list guests are asked to fill in per booking. See
// BookingInfoRequest below, which snapshots this at send time so editing the
// template later never changes a link that's already gone out.
model GuestInfoFormTemplate {
  id        String   @id @default("default")
  fields    Json     @default("[]") // GuestInfoField[] — shape documented in modules/guestInfo/service.ts
  updatedAt DateTime @updatedAt
}

model BookingInfoRequest {
  id          String                   @id @default(uuid())
  bookingId   String
  booking     Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  token       String                   @unique @default(uuid()) // same trust model as Property.icalExportToken — knowing it is the access control
  status      BookingInfoRequestStatus @default(pending)
  fields      Json // GuestInfoField[] snapshot of GuestInfoFormTemplate.fields at creation time
  answers     Json? // { [fieldId]: string | boolean }, set on submit
  expiresAt   DateTime // createdAt + 14 days
  submittedAt DateTime?
  createdAt   DateTime                 @default(now())

  @@index([bookingId])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String
  priceUsd    Decimal  @db.Decimal(10, 2)
  images      String[]
  sku         String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockLevel StockLevel?
  orderItems OrderItem[]
}

model StockLevel {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand    Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt
}

model Order {
  id               String      @id @default(uuid())
  customerName     String
  customerPhone    String
  deliveryAddress  String
  notes            String?
  status           OrderStatus @default(pending)
  paymentMethod    String      @default("cod")
  shippingFee      Decimal     @db.Decimal(10, 2)
  subtotal         Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  flaggedForReview Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items OrderItem[]

  @@index([customerPhone])
  @@index([status])
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @db.Decimal(10, 2)
}

model ContactMessage {
  id        String         @id @default(uuid())
  site      Site
  name      String
  email     String
  subject   ContactSubject
  message   String
  status    LeadStatus     @default(new)
  createdAt DateTime       @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String
  site         Site
  subscribedAt DateTime @default(now())

  @@unique([email, site])
}

// At most one active offer per property is enforced at the application
// layer (see modules/offers/service.ts) rather than a DB constraint — same
// class of soft business rule as turnoverBufferDays, low-stakes enough not
// to need one.
model Offer {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title           String
  discountPercent Int
  imageUrl        String?
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
}

model BlogPost {
  id            String    @id @default(uuid())
  site          Site
  slug          String    @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  author        String
  publishedAt   DateTime? // null = draft, not publicly visible
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([site, publishedAt])
}

model AdminUser {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            AdminRole
  propertyScopeId String?
  propertyScope   Property? @relation(fields: [propertyScopeId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
