# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database (Supabase Postgres connection strings) ---
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Stripe: Italy (The Nest Bologna) ---
STRIPE_ITALY_SECRET_KEY=sk_test_xxx
STRIPE_ITALY_WEBHOOK_SECRET=whsec_xxx

# --- Stripe: Sri Lanka (Dona's Villa) ---
STRIPE_SRILANKA_SECRET_KEY=sk_test_xxx
STRIPE_SRILANKA_WEBHOOK_SECRET=whsec_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="Mansello <bookings@mansello.com>"

# --- File storage (Cloudflare R2 / Supabase Storage — both S3-compatible) ---
# R2: S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com, S3_REGION=auto
# Supabase Storage: S3_ENDPOINT=https://[PROJECT-REF].storage.supabase.co/storage/v1/s3,
#   S3_REGION=<your project's actual region, e.g. ap-northeast-1 — "auto" will NOT work here>
S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mansello-media
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
# R2: your custom public domain / R2.dev URL for the bucket (bucket root).
# Supabase Storage: MUST include the bucket name in the path —
#   https://[PROJECT-REF].supabase.co/storage/v1/object/public/product-images
#   (note: different host than S3_ENDPOINT above — this is Supabase's own
#   REST path for serving public objects, not the S3 endpoint)
S3_PUBLIC_URL=https://media.mansello.com

# --- Jobs ---
AIRBNB_SYNC_CRON="*/30 * * * *"
BOOKING_HOLD_MINUTES=15
