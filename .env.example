# --- Server ---
PORT=4000
NODE_ENV=development
# Allowed origins are hardcoded in src/config/env.ts (not read from an env
# var) — a missing/misconfigured CORS_ORIGIN broke this in production once
# already. Edit that array directly (and redeploy) to change allowed sites.
# Origin guest-facing emailed links (e.g. the booking-info form) point at —
# should be whichever of the above is the real production site.
FRONTEND_URL=https://mansello.com

# --- Database (Supabase Postgres connection strings) ---
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Stripe: Italy (The Nest Bologna) ---
STRIPE_ITALY_SECRET_KEY=sk_test_xxx
STRIPE_ITALY_WEBHOOK_SECRET=whsec_xxx

# --- Stripe: Sri Lanka (Dona's Villa) ---
STRIPE_SRILANKA_SECRET_KEY=sk_test_xxx
STRIPE_SRILANKA_WEBHOOK_SECRET=whsec_xxx

# --- Email (Gmail SMTP — a plain gmail.com address, no domain and no
#     third-party email service needed) ---
# 1. Turn on 2-Step Verification on the Google account (any phone number
#    works for this step — it can be changed later without breaking the app
#    password generated below).
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. GMAIL_USER and the address in EMAIL_FROM must match exactly.
GMAIL_USER=mansellosrilanka@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Mansello <mansellosrilanka@gmail.com>"
# Only needed on a machine whose antivirus/corporate proxy TLS-inspects
# outbound connections (symptom: "self-signed certificate in certificate
# chain" from Node, not from the real mail/API server). Some tools (e.g.
# Norton) already set this for you as a real env var — check
# `echo $NODE_EXTRA_CA_CERTS` / `$env:NODE_EXTRA_CA_CERTS` in a FRESH
# terminal before assuming you need this; if your terminal was already open
# when that got configured, it won't see it until you open a new one. Only
# set it here yourself if a fresh terminal still comes up empty — export the
# tool's injected root cert to a local .pem (keep it out of git; the repo's
# certs/ folder is already gitignored for this) and point Node at it. Never
# needed in production.
# NODE_EXTRA_CA_CERTS=./certs/your-local-proxy-root.pem

# --- File storage (Cloudflare R2 / Supabase Storage — both S3-compatible) ---
# R2: S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com, S3_REGION=auto
# Supabase Storage: S3_ENDPOINT=https://[PROJECT-REF].storage.supabase.co/storage/v1/s3,
#   S3_REGION=<your project's actual region, e.g. ap-northeast-1 — "auto" will NOT work here>
S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mansello-media
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
# R2: your custom public domain / R2.dev URL for the bucket (bucket root).
# Supabase Storage: MUST include the bucket name in the path —
#   https://[PROJECT-REF].supabase.co/storage/v1/object/public/product-images
#   (note: different host than S3_ENDPOINT above — this is Supabase's own
#   REST path for serving public objects, not the S3 endpoint)
S3_PUBLIC_URL=https://media.mansello.com

# --- Jobs ---
AIRBNB_SYNC_CRON="*/30 * * * *"
BOOKING_HOLD_MINUTES=15
